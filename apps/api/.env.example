# AI Marketplace - Environment Variables Template
# Copy this file to .env and fill in your actual values

# App Settings
APP_ENV=production
API_V1_STR=/api/v1
PROJECT_NAME=AI Marketplace API
APP_URL=https://ai-marketplace-drab.vercel.app
CORS_ORIGINS=https://ai-marketplace-drab.vercel.app
FREE_TRIAL_DAYS=30

# Database (Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Redis (Upstash)
REDIS_URL=https://your-upstash-url.upstash.io
REDIS_TOKEN=your-upstash-token-here

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_your_pro_monthly_price
STRIPE_TEAM_PRICE_ID=price_your_team_monthly_price

# Auth
SECRET_KEY=your-super-secure-random-secret-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
