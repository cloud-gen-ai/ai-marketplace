# AI Marketplace - Environment Variables Template
# Copy this file to .env and fill in your actual values

# App Settings
APP_ENV=production
API_V1_STR=/api/v1
PROJECT_NAME=AI Marketplace API

# Database (Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Redis (Upstash)
REDIS_URL=https://your-upstash-url.upstash.io
REDIS_TOKEN=your-upstash-token-here

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Auth
SECRET_KEY=your-super-secure-random-secret-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
